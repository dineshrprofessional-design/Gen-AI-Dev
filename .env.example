# Copy this file to `.env` and fill in your key.
# `.env` is gitignored, so the key will not be committed.

APP_NAME="Gen-AI-Dev API"
VERSION=0.1.0
DEBUG=false

# Where the documentation corpus lives.
DOCS_ROOT=docs

# --- Generation (optional) -------------------------------------------------
# Retrieval works without this. Written answers do not.
# Get a key from https://console.groq.com  (keys start with gsk_)
GROQ_API_KEY=
# To see what your key can use: curl http://127.0.0.1:8000/api/v1/chat/status
GROQ_MODEL=llama-3.3-70b-versatile
